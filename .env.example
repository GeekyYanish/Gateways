# PARALLAX environment contract
# (Backend Implementation Plan, Appendix C)
#
# Copy to .env.local and fill in. .env.local is gitignored — never commit it,
# and never paste these values into a chat, ticket, or commit message.
#
#   cp .env.example .env.local
#   npm run db:check
#
# Values left as-is are rejected at startup: the config validator treats
# unedited placeholders as errors, not defaults.

# --- Database ---------------------------------------------------------------

# Least-privilege application connection.
# Must NOT be able to write xp_ledger, attendance, user_roles, or payment
# verification fields. Never point this at root.
DATABASE_URL=mysql://parallax_app:PASSWORD@host:3306/parallax

# Privileged writer — XP awards, role grants, attendance, payment verification,
# audit rows. Server-only; never imported by general or client modules.
#
# If your host does not allow CREATE USER, you may temporarily set this to the
# same value as DATABASE_URL. That disables the least-privilege invariant;
# `npm run db:check` will warn, and the gap belongs in DECISIONS.md.
WRITER_DATABASE_URL=mysql://parallax_writer:PASSWORD@host:3306/parallax

# TLS. Leave unset when the server certificate chains to a public root, which is
# the case for most managed MySQL. Set to a CA file path for a private root.
# DB_SSL_CA_PATH=./certs/preproduction-ca.pem

# Disables certificate verification. Encryption without authentication — an
# active MITM still works. Refused outright when NODE_ENV=production.
# DB_SSL_INSECURE=false

# Pool and timeout bounds. Defaults shown; override only with a reason.
# DB_POOL_SIZE=10
# DB_WRITER_POOL_SIZE=3
# DB_STATEMENT_TIMEOUT_MS=10000
# DB_LOCK_WAIT_TIMEOUT_S=10

# --- Auth (Person 2 — not yet required) -------------------------------------

# AUTH_SECRET=
# CHECKIN_TOKEN_SECRET=   # HMAC key for QR tokens; independent from AUTH_SECRET
# APP_BASE_URL=http://localhost:3000

# --- Storage (frontend only) ------------------------------------------------

# STORAGE_BUCKET_URL=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# SMTP is server-only and belongs in the Gateways backend environment.
# Never put SMTP credentials in this frontend .env.local or in NEXT_PUBLIC_*.
