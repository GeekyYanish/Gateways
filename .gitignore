# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Ignore loose PNGs (exports, scratch) but ship committed art under public/art/.
*.png
!public/art/**/*.png
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# editors / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build tool caches
.turbo/
.swc/
.cache/

# claude code (machine-local: contains absolute paths & per-user permissions)
.claude/settings.local.json
.claude/launch.json

poster_page/
deliverables/
*.doc
*.docx
