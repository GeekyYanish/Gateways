# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Ignore loose PNGs (exports, scratch) but ship committed art under public/art/.
*.png
!public/art/**/*.png
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.cert
*.crt
*.sqlite
*.sql

# Large source-only 3D exports. Optimized runtime models live in public/art/.
/assets/festive_world_-_minecraft.glb
/assets/minecraft_3d_render_free.glb
/assets/minecraft_village.glb

# editors / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
.env.example

# The backend templates in src/backend are intentionally tracked without a dot
# prefix; these matching local files contain secrets and must stay machine-only.
src/backend/env
src/backend/env.preproduction
src/backend/env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build tool caches
.turbo/
.swc/
.cache/

# claude code (machine-local: contains absolute paths & per-user permissions)
.claude/settings.local.json
.claude/launch.json

poster_page/
deliverables/
*.doc
*.docx
handover.md
*.doc
*.docx
registration-console/
BACKEND-API-CONTRACT.md
poster_page.zip

# Secrets must never be committed, including copies that lack the leading dot.
# A stray src/backend/env holding AUTH_SECRET and DB_PASSWORD once slipped
# through precisely this way — .gitignore only covered dotted names.
**/env

# Documents
*.md
*.pdf
