# Production environment.
#
# Copy to .env.production.local and fill in the production backend's address.
# Unlike preproduction, this needs no special script or flag: `next build` and
# `next start` set NODE_ENV=production and Next.js loads .env.production.local
# automatically. On a hosting platform (Vercel, Render, ...) set these as real
# environment variables in that platform's dashboard instead of shipping this
# file — either way they land in `process.env` the same way.

REGISTRATION_API_URL=https://api.gateways.example

NEXT_PUBLIC_USE_API_BACKEND=true
