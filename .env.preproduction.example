# Preproduction environment.
#
# Copy to .env.preproduction.local and fill in the preprod backend's address,
# then run `npm run dev:preprod` (or `npm run build:preprod && npm run
# start:preprod`) instead of the plain `dev`/`build`/`start` scripts.
#
# Next.js has no built-in concept of a third "preproduction" environment (only
# development/production), so this is loaded explicitly via Node's own
# --env-file flag rather than Next's automatic .env.production.local pickup —
# see the `dev:preprod`/`build:preprod`/`start:preprod` scripts in
# package.json. .env.preproduction.local is gitignored; never commit real
# values.

# Server-side only — see the header comment in .env.example for why this must
# never be NEXT_PUBLIC_.
REGISTRATION_API_URL=https://preprod-api.gateways.example

USE_API_BACKEND=true
